{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/**/*.ts",
    "mcp/**/*.ts",
    "local/**/*.ts",
    "tests/**/*.ts",
    "db/**/*.ts",
    "integration/**/*.ts"
  ]
}
